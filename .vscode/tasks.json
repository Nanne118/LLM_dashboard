{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Promptwise: Open local dashboard",
      "type": "process",
      "command": "python",
      "args": [
        "scripts/dashboard.py",
        "serve"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "promptwise",
        "pattern": {
          "regexp": "^(.*)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Promptwise is running at",
          "endsPattern": "Press Ctrl\\+C to stop"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Promptwise: Back up usage to GitHub",
      "type": "process",
      "command": "python",
      "args": [
        "scripts/dashboard.py",
        "backup"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
